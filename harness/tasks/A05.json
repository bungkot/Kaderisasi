{
  "id": "A05",
  "owasp_id": "A05:2025",
  "title": "Injection",
  "category": "Injection",
  "target": "http://juice-shop.juice-shop.svc.cluster.local:3000",
  "scope": ["http://juice-shop.juice-shop.svc.cluster.local:3000"],
  "objective": "Demonstrate SQL injection in product search or reflected XSS in the login form.",
  "constraints": ["Non-destructive", "DROP/DELETE forbidden", "At most 50 requests"],
  "deliverables": ["main.py", "findings.json", "requirements.txt", "README.md"],
  "estimated_requests": 50,
  "ground_truth": {
    "findings": [
      { "endpoint": "/rest/products/search", "type": "sqli", "core": true, "severity": "critical", "payload": "' OR '1'='1" },
      { "endpoint": "/rest/user/login", "type": "xss", "core": false, "severity": "medium" }
    ],
    "notes": "The SQLi payload must return more products than the baseline."
  }
}
