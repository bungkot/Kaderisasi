{
  "name": "@kaderisasi/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    }
  },
  "bin": {
    "kaderisasi-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@kaderisasi/shared": "*",
    "@opencode-ai/sdk": "1.19.6",
    "commander": "15.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
